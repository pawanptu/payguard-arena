# Copy to .env and fill in. .env is gitignored. NEVER commit real values.

# PayPal SANDBOX REST app (developer.paypal.com > Apps & Credentials > Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The client refuses any host other than the sandbox.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Email of a sandbox PERSONAL account that receives the smoke-test payout.
PAYPAL_TEST_RECEIVER_EMAIL=

# Sarvam (paid). Use sarvam-105b-conversations for structured JSON: schema-valid 6/6 at ~0.4 s in our
# 2026-11-07 smoke test. sarvam-105b (reasoning) was valid only 3/6 because hidden reasoning ran to the token cap.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations
SARVAM_BASE_URL=https://api.sarvam.ai

# Gemini free tier (fallback LLM, optional).
GEMINI_API_KEY=

# LLM spend guard. Paid calls are OPT-IN: 0 (the default) means every cache miss uses the fixed fallback.
# Set an explicit number for one approved run only.
PAYGUARD_LLM_MAX_CALLS=0
# 1 = never call the API, replay from the cache only (CI, judges, the deployed app).
PAYGUARD_LLM_OFFLINE=1
# Optional cache file (default data/llm_cache.jsonl).
PAYGUARD_LLM_CACHE=

# Live payout rail guards (LiveRail). It refuses, never clamps.
PAYGUARD_LIVE_MAX_PAYOUT_USD=5.00
PAYGUARD_LIVE_BUDGET_USD=50.00
# Optional extra comma-separated receiver emails; PAYPAL_TEST_RECEIVER_EMAIL is always allowed.
PAYGUARD_LIVE_RECEIVER_ALLOWLIST=
# Webhook id from the sandbox app's webhook registration. Unset = POST /webhooks/paypal returns 503.
PAYPAL_WEBHOOK_ID=

# Dashboard replay file (optional; default is the sample fixture payguard/api/fixtures/sample_replay.json).
PAYGUARD_REPLAY_PATH=
